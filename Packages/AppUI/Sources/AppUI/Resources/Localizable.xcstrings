        "zh-Hans": { "stringUnit": { "state": "translated", "value": "守护状态尚未验证" } }
      }
    },
    "sentinel.alert.unregister_failed.body %@": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The background sentinel could not be disabled, so the switch was restored. Review Login Items in System Settings, then try again. Technical details: %@" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法关闭后台守护任务，开关已恢复。请检查「系统设置」中的登录项后重试。技术详情：%@" } }
      }
    },
    "sentinel.alert.unregister_failed.startup.body %@": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The saved request to disable the background sentinel was kept, but macOS could not confirm that it stopped. It may still be registered or running. Review Login Items in System Settings, then try again. Technical details: %@" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已保留关闭后台守护的期望，但 macOS 无法确认它已经停止，守护任务仍可能处于已注册或运行状态。请检查「系统设置」中的登录项后重试。技术详情：%@" } }
      }
    },
