    "settings.dev.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer scan does a BFS from your home directory looking for hit directories (e.g. node_modules / build / Pods / target / __pycache__) and requires a scaffold file (e.g. package.json / pubspec.yaml / Cargo.toml) as a sibling to avoid false positives. Once a hit is found the whole subtree is pruned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发者扫描会从 ~ 整个家目录 BFS 查找命中目录（如 node_modules / build / Pods / target / __pycache__ 等），并要求兄弟里有对应脚手架文件（如 package.json / pubspec.yaml / Cargo.toml）以避免误命中。命中后整棵剪枝不再下钻。"
          }
        }
      }
    },
