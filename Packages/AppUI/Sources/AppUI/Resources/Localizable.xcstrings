    "settings.storage.alert.delete_files.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the .sqlite + -wal + -shm files directly from disk (most destructive). A new database will be built on the next launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接从磁盘删除 .sqlite + -wal + -shm 三个文件（破坏性最强）。下次启动会重新建库。"
          }
        }
      }
