    "tree.access.permission_denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNo access: the scanner cannot read this directory. Please grant Full Disk Access in System Settings → Privacy & Security, then rescan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n无访问权限：扫描器无法读取此目录里的文件。请在「系统设置 → 隐私与安全性 → 完整磁盘访问」中授权后重新扫描。"
          }
        }
      }
    },
    "tree.access.tcc_protected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nSystem-protected: this directory is protected by TCC. Grant Full Disk Access in System Settings → Privacy & Security to inspect it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n受系统保护：此目录受 TCC 保护，需要在「系统设置 → 隐私与安全性 → 完整磁盘访问」中授权后才能查看。"
          }
        }
      }
    },
    "tree.column.sort_help": {
      "extractionState": "manual",
