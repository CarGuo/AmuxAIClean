        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何授权？"
          }
        }
      }
    },
    "tcc.guide.skip.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app will run in degraded mode and some scans may show no results."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用将以受限模式运行，部分扫描可能无结果。"
