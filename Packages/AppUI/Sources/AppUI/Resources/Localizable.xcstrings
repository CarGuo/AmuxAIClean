          }
        }
      }
    },
    "settings.scan.section.size_mode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size accounting mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体积统计口径"
          }
        }
      }
    },
    "settings.scan.show_hidden.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ON by default: includes dot-prefixed directories such as .cursor / .npm / .cache so totals match Finder/du. When off, only visible files are scanned and totals will be noticeably smaller than Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 ON：扫描会包含 .cursor / .npm / .cache 等以 . 开头的目录，体积才能与 Finder/du 对齐。关掉后只看可见文件，结果会显著小于 Finder。"
          }
        }
      }
    },
    "settings.scan.show_hidden.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show hidden files / folders"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示隐藏文件 / 文件夹"
          }
        }
      }
    },
    "settings.scan.size_mode.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "logical (default): matches System Settings / Finder / Get Info; APFS clones / hardlinks are not deduplicated and every file counts its full size.\\nphysical: matches du / df; counts actual disk blocks, so sparse / hardlinked files are smaller and reflect what you would actually reclaim.\\nA rescan is required after switching for totals to recompute under the new mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "logical（默认）：与系统设置 / Finder / 「显示简介」完全一致；APFS clone / hardlink 不去重，每个文件按完整 size 算。\\nphysical：与 du / df 一致；按实际占用磁盘 block 算，sparse / hardlink 文件更小，反映「删了真能释放多少」。\\n切换后需要重新扫描才能让总数按新口径累计。"
          }
        }
      }
    },
    "settings.scan.size_mode.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Byte accounting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字节口径"
          }
        }
      }
    },
    "settings.scan.tray.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ON by default. Shows an icon in the right side of the menu bar; click to open the main window, start the recommended scan, or toggle the HUD. The icon is removed immediately when turned off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 ON。在系统菜单栏右侧显示一个图标，点击可快速打开主窗口、开始推荐扫描、显示/隐藏悬浮窗。关掉后图标立即移除。"
          }
        }
      }
    },
    "settings.scan.tray.title": {
