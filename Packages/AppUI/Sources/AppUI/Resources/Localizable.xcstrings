    "sentinel.alert.status_unavailable.body %@": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "macOS could not verify the background sentinel's actual state, so the switch was restored. Review Login Items in System Settings and try again. Technical details: %@" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "macOS 无法验证后台守护的实际状态，因此开关已恢复。请检查「系统设置」中的登录项后重试。技术详情：%@" } }
      }
    },
    "sentinel.alert.status_unavailable.startup.body %@": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The saved background sentinel preference was kept, but macOS could not verify its actual state. The settings page will show the requested and actual states separately. Technical details: %@" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已保留后台守护的期望设置，但 macOS 无法验证实际状态；设置页会分别显示期望与实际状态。技术详情：%@" } }
      }
    },
    "sentinel.alert.status_unavailable.title": {
      "extractionState": "manual",
      "localizations": {
