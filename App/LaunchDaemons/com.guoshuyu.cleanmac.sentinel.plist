<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      v2026.10.14: restore the pre-brand root registration's migration-only descriptor.
      Its filename and Label are persistent ServiceManagement identities, not display names.
      Keep this descriptor until the supported upgrade window is explicitly retired;
      SentinelManager may only query/unregister this service, never register it again.
    -->
    <key>Label</key>
    <string>com.guoshuyu.cleanmac.sentinel</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/amuxaiclean-sentinel</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/com.guoshuyu.cleanmac.sentinel.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.guoshuyu.cleanmac.sentinel.err.log</string>
</dict>
</plist>
