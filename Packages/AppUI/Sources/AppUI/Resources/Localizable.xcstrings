      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The current item is allowed to finish safely before another item starts." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前项目会安全完成后，才会开始下一项。" } }
      }
