    "banner.fda.tcc.privacy_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: sensitive libraries such as Apple Music / Photos / Mail are skipped to avoid repeated permission prompts; these folders are unrelated to this app's cleanup targets (caches / duplicates / uninstall leftovers)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明：Apple Music / Photos / Mail 等敏感库已主动跳过，避免系统反复弹权限框；这些目录与本 App 的清理目标（缓存/重复文件/卸载残留）无关。"
          }
        }
      }
    },
