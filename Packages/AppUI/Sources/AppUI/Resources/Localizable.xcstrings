    "workflow.detail.managed_uninstall.consequence.devices": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The selected Simulator devices and their app data will be permanently deleted through CoreSimulator. They will not be moved to Trash." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "所选模拟器设备及其中的 App 数据将通过 CoreSimulator 永久删除，不会移入废纸篓。" } }
      }
    },
    "workflow.detail.managed_uninstall.consequence.mixed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The selected Simulator devices will be permanently deleted and the selected runtimes will be uninstalled through CoreSimulator. None of these items will be moved to Trash." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "所选模拟器设备将被永久删除，所选运行时将通过 CoreSimulator 卸载；这些项目均不会移入废纸篓。" } }
      }
    },
    "workflow.detail.managed_uninstall.consequence.runtimes": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The selected Simulator runtimes will be uninstalled through CoreSimulator. They will not be moved to Trash or be restorable, but you can download them again from Xcode > Settings > Components." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "所选模拟器运行时将通过 CoreSimulator 卸载，不会移入废纸篓，也无法恢复；之后可在 Xcode「设置 > 组件」中重新下载。" } }
      }
    },
