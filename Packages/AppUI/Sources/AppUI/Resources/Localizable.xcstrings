    "capacity.legend.system_reclaimable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS May Release"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 可能释放"
          }
        }
      }
    },
    "capacity.reclaimable.info.action": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "It is not one folder, and there is no safe “Clear All” action. Manage identifiable content in its own Settings pane or app—for example, turning off Apple Intelligence removes its on-device models. macOS reclaims the remaining system-managed data when needed." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "它不是某一个目录，也不存在安全的“一键全部清除”。可识别的内容应在所属设置或应用中管理；例如关闭 Apple Intelligence 会移除其设备端模型。其余系统管理的数据由 macOS 在需要时自动回收。" } }
      }
    },
    "capacity.reclaimable.info.action.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I clear it now?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能现在清掉吗？"
          }
        }
      }
    },
    "capacity.reclaimable.info.changes": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The estimate can jump when macOS recalculates caches, local snapshots, or downloadable system assets, such as on-device Apple Intelligence models. A change here does not by itself mean that files of the same size were just added or removed." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "macOS 重新评估缓存、本地快照或可重新下载的系统资源（例如设备端 Apple Intelligence 模型）时，这个估算可能突然变化。仅仅数字变化，并不代表刚刚新增或删除了同等大小的文件。" } }
      }
    },
    "capacity.reclaimable.info.changes.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Why can it change suddenly?" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "为什么会突然变化？" } }
      }
    },
    "capacity.reclaimable.info.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About system-reclaimable space"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解系统可能释放的空间"
          }
        }
      }
    },
    "capacity.reclaimable.info.relationship": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Available Now” is free space you can use immediately. “macOS May Release” is system-managed data that macOS estimates it could discard if space is needed. Adding them gives the “Estimated Maximum Available,” but that total is not guaranteed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“当前空闲”是现在就能使用的真实空闲空间。“macOS 可能释放”是系统估算在需要空间时可以丢弃的系统管理数据。两者相加得到“预计可用上限”，但这个总数并非保证。"
          }
        }
      }
    },
    "capacity.reclaimable.info.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System-Reclaimable Space"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统可能释放的空间"
          }
        }
      }
    },
    "capacity.retry": {
      "extractionState": "manual",
      "localizations": {
