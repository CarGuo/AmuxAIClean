    },
    "op.result.force_delete.confirm.message %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These %lld item(s) were blocked by vendor rules (e.g., Android SDK system-images). Force delete bypasses vendor rules but still keeps system-level safety nets (system volumes, credentials, hard-forbidden paths). Items will be moved to Trash and can be restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这 %lld 项被 vendor 规则（如 Android SDK system-images）拦下。强制删除会绕过 vendor 规则，但仍然保留系统级安全网（系统卷、凭据、硬禁路径）。文件会移入废纸篓，可随时恢复。"
          }
        }
      }
    },
    "op.result.force_delete.confirm.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand, delete anyway"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已知风险，仍然删除"
          }
        }
      }
    },
    "op.result.force_delete.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force delete vendor-blocked items?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认强制删除被 vendor 规则拦下的项？"
          }
        }
      }
    },
    "op.result.hint.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These paths are protected by built-in safety rules to prevent destroying the system or other apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些路径被内置安全规则保护，避免误删系统或其他应用。"
          }
        }
      }
    },
    "op.result.hint.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These paths could not be moved to Trash. Common causes: the file is in use by another process (e.g. running emulator), permissions issue, or special attributes (xattr / read-only). Try quitting the related app and retry, or delete the path manually in Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些路径无法移到废纸篓。常见原因：文件被其他进程占用（如运行中的模拟器）、权限问题、或特殊属性（xattr / 只读）。可以先退出相关应用再重试，或者在「访达」里手动删除。"
          }
        }
      }
    },
