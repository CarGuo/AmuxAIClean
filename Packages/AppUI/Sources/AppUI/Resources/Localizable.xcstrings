    "tree.access.incomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nIncomplete scan: this directory could not be fully enumerated. Rescan before attempting to remove it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n扫描不完整：此目录未能完整枚举。请重新扫描后再尝试移除。"
          }
        }
      }
    },
    "tree.access.permission_denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNo access: the scanner cannot read this directory. Please grant Full Disk Access in System Settings → Privacy & Security, then rescan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n无访问权限：扫描器无法读取此目录里的文件。请在「系统设置 → 隐私与安全性 → 完整磁盘访问」中授权后重新扫描。"
          }
        }
      }
    },
