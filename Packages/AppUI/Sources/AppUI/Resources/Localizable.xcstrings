          "stringUnit": {
            "state": "translated",
            "value": "提示：完全磁盘访问已可用，但这些路径被文件归属或 POSIX mode 权限阻塞。本 App 不会为了清理扫描请求管理员权限。"
          }
        }
      }
    },
    "permission.hint.fda_denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: This process detected FDA = denied. If you just toggled AmuxAIClean on in System Settings, fully quit and relaunch the app, then confirm the .app you authorized is exactly the one running now. For Debug builds, compare the running path and code requirement with Scripts/diagnose_debug_tcc.sh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：当前进程探测到 FDA = 未授权。如果你刚刚在系统设置里给 AmuxAIClean 打了勾，请完全退出并重启本 App，然后确认你授权的 .app 就是当前正在运行的这个。Debug 构建请用 Scripts/diagnose_debug_tcc.sh 对比运行路径和 code requirement。"
          }
        }
      }
    },
    "permission.hint.fda_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Could not detect FDA status (no probe files — user has never used Mail/Safari/Messages). Please go to System Settings → Privacy & Security → Full Disk Access to confirm authorization."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：未能探测到 FDA 状态（用户从未用过 Mail/Safari/Messages，没有探针文件）。请直接到 系统设置 → 隐私与安全 → 完全磁盘访问 中确认授权。"
          }
        }
      }
    },
    "permission.hint.files_and_folders": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Downloads/Documents/Desktop/Trash and removable volumes are NOT covered by Full Disk Access on macOS 14+. They need a separate switch under System Settings → Privacy & Security → Files and Folders → AmuxAIClean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：在 macOS 14+ 上，下载/文稿/桌面/废纸篓/可移动卷 不属于「完全磁盘访问」管辖，需要在 系统设置 → 隐私与安全性 → 文件与文件夹 → AmuxAIClean 下单独打开开关。"
          }
        }
      }
    },
    "permission.hint.trash_not_fda": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: ~/.Trash is not covered by Full Disk Access — it is a separate privacy item on macOS 14+. Allow it under System Settings → Privacy & Security → Automation / Files and Folders, or use Finder's built-in \"Empty Trash\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：~/.Trash 不属于「完全磁盘访问」范畴——它是 macOS 14+ 单独的隐私项，需要在 系统设置 → 隐私与安全 → 自动化 / 文件与文件夹 里单独允许；或者改用 Finder 自带的「清空废纸篓」。"
          }
        }
      }
    },
