{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "ai.advice.local_policy_override.prefix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Overridden by local policy] "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[本地安全策略已覆盖] "
          }
        }
      }
    },
    "ai.advice.unparsable.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI returned an unparsable response. Showing raw text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 返回的内容无法解析，已展示原文。"
          }
        }
      }
    },
    "ai.keychain.error.stale_file_reference": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved API key is tied to an older app build and macOS can no longer access it. Open Settings → AI and save the key again. If saving still fails, remove the old AmuxAIClean API key item in Keychain Access, then save again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的 API Key 仍绑定旧版 App，macOS 现在无法访问。请打开「设置 → AI」重新保存；若保存仍失败，请先在「钥匙串访问」中删除旧的 AmuxAIClean API Key 项目，再重新保存。"
          }
        }
      }
    },
    "ai.keychain.error.system.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Keychain could not be accessed (%@). Open Settings → AI and save the API key again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问 macOS 钥匙串（%@）。请打开「设置 → AI」重新保存 API Key。"
          }
        }
      }
    },
    "ai.keychain.error.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key could not be accessed. Open Settings → AI and save it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问 API Key。请打开「设置 → AI」重新保存。"
          }
        }
      }
    },
    "ai.sheet.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "ai.sheet.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advisory only. The built-in safety engine remains the final authority for selection: items flagged forbid stay locked even if AI says otherwise."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 建议仅供参考。本地三档安全闸仍是勾选的唯一权威：本地判为 forbid 的项不会因 AI 解读而解锁。"
          }
        }
      }
    },
    "ai.sheet.error.http.status %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server returned HTTP %lld. Review the app log for technical details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端返回 HTTP %lld，可在应用日志中查看技术详情。"
          }
        }
      }
    },
    "ai.sheet.error.insecure_base_url.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insecure Base URL: %1$@://%2$@. Use HTTPS for remote endpoints, or HTTP only for localhost / 127.0.0.1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL 不安全：%1$@://%2$@。远端端点请使用 HTTPS；HTTP 仅允许 localhost / 127.0.0.1。"
          }
        }
      }
    },
    "ai.sheet.error.invalid_base_url": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL is not a valid endpoint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL 不是有效的端点。"
          }
        }
      }
    },
    "ai.sheet.error.no_api_key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key is missing. Open Settings → AI to add it (or leave empty for a local Ollama / vLLM endpoint that needs no auth)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置 API Key。请到「设置 → AI」中填写（或留空，若使用本地 Ollama / vLLM 等无鉴权端点）。"
          }
        }
      }
    },
    "ai.sheet.error.not_configured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is not fully configured. Open Settings → AI to enable it and set a base URL / model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 尚未配置完成。请打开「设置 → AI」启用并填写 Base URL / 模型。"
          }
        }
      }
    },
    "ai.sheet.error.transport": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network request failed. Check your connection and review the app log for technical details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络请求失败，请检查连接；技术详情可在应用日志中查看。"
          }
        }
      }
    },
    "ai.sheet.error.unexpected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request could not be completed. Review the app log for technical details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求未能完成，技术详情可在应用日志中查看。"
          }
        }
      }
    },
    "ai.sheet.failed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求失败"
          }
        }
      }
    },
    "ai.sheet.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asking the model..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在询问模型…"
          }
        }
      }
