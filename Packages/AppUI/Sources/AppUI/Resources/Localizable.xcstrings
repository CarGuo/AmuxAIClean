    "sentinel.alert.register_failed.startup.body %@": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The saved request to enable the background sentinel was kept, but the helper is not running. Review Login Items in System Settings, then try again. Technical details: %@" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已保留开启后台守护的期望，但守护任务当前未运行。请检查「系统设置」中的登录项后重试。技术详情：%@" } }
