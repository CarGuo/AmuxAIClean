    "undo_history.conflict.message %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld original location already contains an item. The existing item will not be changed. Restore the older item with a new name, or skip this conflict."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld original locations already contain an item. Existing items will not be changed. Restore the older items with new names, or skip those conflicts."
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 个原位置已有项目。现有项目不会被改动。你可以把旧项目恢复为新名称，或跳过该冲突。"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 个原位置已有项目。现有项目不会被改动。你可以把旧项目恢复为新名称，或跳过这些冲突。"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
