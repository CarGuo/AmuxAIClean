    "settings.storage.section.cleanup.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From light to heavy: VACUUM only compacts space; clearing tables drops scan history but keeps the schema; deleting files is the most thorough and the database will be rebuilt next launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由轻到重：VACUUM 仅紧凑空间；清空表丢扫描历史保留 schema；删文件最彻底，下次启动重建。"
          }
        }
      }
    },
