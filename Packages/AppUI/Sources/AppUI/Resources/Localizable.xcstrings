    "settings.ai.enabled.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, right-click a row in the main list and choose \"Ask AI\" to get a one-shot opinion on what the path is and whether it is safe to delete. No automatic requests are made; one click = one HTTP request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，可在主列表右键单击行并选择「问 AI」，由配置的 AI 给出一次性判断：这是什么、是否可删。不会自动发起任何请求；一次点击 = 一次 HTTP 请求。"
          }
        }
      }
    },
    "settings.ai.enabled.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable AI assistant"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 AI 助手"
          }
        }
      }
    },
    "settings.ai.endpoint.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatible with any OpenAI-protocol endpoint (Azure / DeepSeek / OpenRouter / Ollama / vLLM / Qwen / ...). Examples: https://api.openai.com, https://api.deepseek.com, http://localhost:11434/v1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容任何 OpenAI 协议端点（Azure / DeepSeek / OpenRouter / Ollama / vLLM / 通义 等）。示例：https://api.openai.com、https://api.deepseek.com、http://localhost:11434/v1"
          }
        }
      }
    },
    "settings.ai.howto.disabled_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: the \"Ask AI\" right-click menu is hidden until \"AI Assistant\" below is turned on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：未打开下方「启用 AI 助手」时，主界面右键不会出现「问 AI」菜单项。"
          }
        }
      }
    },
    "settings.ai.howto.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Turn on \"AI Assistant\" below and fill in the endpoint / model / API Key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 打开下方的「启用 AI 助手」总开关，并填好端点 / 模型 / API Key。"
          }
        }
      }
    },
    "settings.ai.howto.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Back to the main window, right-click any scan result row (recommended cleanups, large files, custom paths, tree browser) and choose ✨ \"Ask AI\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 回到主界面，在任意扫描结果行（推荐清理 / 大文件 / 自定义路径 / 树视图）上右键，选择 ✨「问 AI」即可询问该路径是否可以删除。"
          }
        }
      }
    },
    "settings.ai.howto.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. The result sheet only shows advice; nothing is auto-selected for deletion. The local 3-tier gate (safe / confirm / forbid) stays the final authority."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 结果面板只展示建议，不会自动勾选删除。最终是否删除仍由本地三档闸（安全 / 确认 / 禁止）说了算。"
          }
        }
      }
    },
    "settings.ai.howto.title": {
