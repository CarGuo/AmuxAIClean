    "settings.scan.hide_dock.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OFF by default. When on, closing the main window hides the app into the menu bar tray (Dock icon and main menu disappear together). Click \"Open Main Window\" in the tray to bring it back. The tray icon must remain enabled, otherwise the app has no entry point after closing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 OFF。开启后，关掉主窗口 = App 隐入菜单栏托盘（Dock 图标 + 顶部主菜单一起消失）；点托盘 \"打开主窗口\" 即可拉回。需要保留菜单栏托盘开启，否则 App 关窗后将完全没有入口。"
          }
        }
      }
    },
    "settings.scan.hide_dock.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide from Dock when main window is closed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭主窗口后从 Dock 隐藏"
          }
        }
      }
    },
    "settings.scan.hud.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ON by default. While scanning, a capsule under the notch shows reclaimable / free / progress bar / ETA. Toggle anytime with ⌘⇧H or the toolbar button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 ON。扫描时在屏幕顶部刘海下方居中显示一个胶囊：可清理 / 可用 / 比例条 / 预计剩余时间。可随时通过 ⌘⇧H 或工具栏按钮切换。"
          }
        }
      }
    },
    "settings.scan.hud.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan HUD"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描悬浮窗（HUD）"
          }
        }
      }
    },
    "settings.scan.hud_persistent.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the HUD stays visible even when not scanning, acting as a desktop / top widget. The idle state shows disk usage and a one-click scan button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后即使未在扫描，HUD 也持续显示，作为桌面 / 顶部小挂件。闲置态显示磁盘已用比例 + 一键开始扫描。"
          }
        }
      }
    },
    "settings.scan.hud_persistent.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persistent HUD widget mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HUD 常驻挂件模式"
          }
        }
      }
    },
    "settings.scan.hud_placement.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top center (under the notch) = floating level, always above every app window. The three desktop options sit above desktop icons but below app windows, mimicking a desktop widget without stealing focus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶部居中（刘海下方）= floating 级，永远在所有 App 窗口之上；桌面三档 = 桌面图标之上、App 窗口之下，模拟桌面小控件，不抢前台焦点。"
          }
        }
      }
    },
    "settings.scan.hud_placement.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HUD placement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HUD 位置"
          }
        }
      }
    },
    "settings.scan.section.behavior": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan behavior"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描行为"
          }
        }
      }
    },
    "settings.scan.section.interface": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
