    "tcc.guide.how.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings → Privacy & Security → Full Disk Access, then toggle on AmuxAIClean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开「系统设置 → 隐私与安全性 → 完全磁盘访问」，开启 AmuxAIClean。"
          }
        }
      }
    },
    "tcc.guide.how.title": {
      "extractionState": "manual",
