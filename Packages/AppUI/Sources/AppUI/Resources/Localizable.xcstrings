    "tcc.guide.skip.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What if I skip it?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果跳过会怎样？"
          }
        }
      }
    },
    "tcc.guide.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To accurately clean leftover caches in private folders such as Mail / Safari / Calendar, AmuxAIClean needs Full Disk Access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了准确清理 Mail / Safari / 日历等隐私目录的残留缓存，AmuxAIClean需要「完全磁盘访问」权限。"
          }
        }
      }
    },
    "tcc.guide.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Full Disk Access"
          }
        },
        "zh-Hans": {
