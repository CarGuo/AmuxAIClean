    "settings.advanced.sentinel.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passively watches Trash and a few hot caches when the system is idle. When 5GB+ of cumulative noise is detected over 30s, the main app is pinged via amuxaiclean:// to surface candidates. Off by default; toggle off any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在系统空闲时被动监听废纸篓与少量缓存目录。30 秒内累计噪音超过 5GB 时通过 amuxaiclean:// 唤起主 App 提示候选项。默认关闭，随时可关。"
          }
        }
      }
    },
    "settings.advanced.sentinel.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First enable may require approval in System Settings → General → Login Items & Extensions. The helper consumes < 10MB RAM and exits cleanly when disabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次启用可能需要在「系统设置 → 通用 → 登录项与扩展」中授权。守护进程内存占用 < 10MB，关闭后立即干净退出。"
          }
        }
      }
    },
    "settings.advanced.sentinel.last_enabled": {
      "extractionState": "manual",
      "localizations": {
