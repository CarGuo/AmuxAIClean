    "workflow.detail.managed_uninstall.failure.command_failed %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "CoreSimulator could not complete the operation (exit code %lld). Technical details were written to the app log." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "CoreSimulator 未能完成此操作（退出码 %lld）。技术详情已记录到应用日志。" } }
      }
    },
    "workflow.detail.managed_uninstall.failure.command_rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The operation was rejected by the command safety rules before submission. Nothing was changed." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "命令安全规则在提交前拒绝了此操作；没有更改任何资源。" } }
      }
    },
    "workflow.detail.managed_uninstall.failure.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The operation could not be completed. Technical details were written to the app log." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此操作无法完成。技术详情已记录到应用日志。" } }
      }
    },
    "workflow.detail.managed_uninstall.failure.launch_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "CoreSimulator could not be started for this operation. Nothing was submitted; technical details were written to the app log." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法为此操作启动 CoreSimulator。操作尚未提交；技术详情已记录到应用日志。" } }
      }
    },
    "workflow.detail.managed_uninstall.failure.pending_operation": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This resource already has an operation awaiting a terminal status. It was not submitted again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此资源已有一个操作仍在等待终态，因此没有重复提交。" } }
      }
    },
    "workflow.detail.managed_uninstall.failure.persistent_pending": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A previous managed operation for this resource has not been reconciled. It was not submitted again. Rescan first, or manage the resource in Xcode." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此资源之前的管理操作尚未完成权威对账，因此没有重复提交。请先重新扫描，或在 Xcode 中管理此资源。" } }
      }
    },
    "workflow.detail.managed_uninstall.failure.resource_absent": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "CoreSimulator confirms that this resource is no longer installed. Nothing was submitted; rescan to refresh the list." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "CoreSimulator 已确认此资源不再安装。本次未提交操作；请重新扫描以刷新列表。" } }
      }
    },
    "workflow.detail.managed_uninstall.failure.safety_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The current Simulator device state could not be verified, so the operation was not submitted." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法核验当前模拟器设备状态，因此没有提交此操作。" } }
      }
    },
