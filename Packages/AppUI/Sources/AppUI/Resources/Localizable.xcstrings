  "strings": {
    "ai.advice.local_policy_override.prefix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Overridden by local policy] "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[本地安全策略已覆盖] "
          }
        }
      }
    },
    "ai.advice.unparsable.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI returned an unparsable response. Showing raw text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 返回的内容无法解析，已展示原文。"
          }
        }
      }
    },
    "ai.sheet.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "ai.sheet.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advisory only. The built-in safety engine remains the final authority for selection: items flagged forbid stay locked even if AI says otherwise."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 建议仅供参考。本地三档安全闸仍是勾选的唯一权威：本地判为 forbid 的项不会因 AI 解读而解锁。"
          }
        }
      }
    },
    "ai.sheet.error.http.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server returned HTTP %lld. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端返回 HTTP %lld。%@"
          }
        }
      }
    },
    "ai.sheet.error.insecure_base_url.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insecure Base URL: %1$@://%2$@. Use HTTPS for remote endpoints, or HTTP only for localhost / 127.0.0.1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL 不安全：%1$@://%2$@。远端端点请使用 HTTPS；HTTP 仅允许 localhost / 127.0.0.1。"
          }
        }
      }
    },
    "ai.sheet.error.invalid_base_url": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL is not a valid endpoint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL 不是有效的端点。"
          }
        }
      }
    },
    "ai.sheet.error.keychain.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
