<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- v2026.07.18: the active Sentinel is a per-login, non-privileged agent. -->
    <key>Label</key>
    <string>com.amux.ai.Clean.sentinel.agent</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/amuxaiclean-sentinel</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
