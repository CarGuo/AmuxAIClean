    "tcc.guide.how.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings → Privacy & Security → Full Disk Access, then toggle on GSYCleanMac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开「系统设置 → 隐私与安全性 → 完全磁盘访问」，开启 GSYCleanMac。"
          }
        }
      }
    },
    "tcc.guide.how.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to grant access?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何授权？"
          }
        }
      }
    },
    "tcc.guide.skip.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app will run in degraded mode and some scans may show no results."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用将以受限模式运行，部分扫描可能无结果。"
          }
        }
      }
    },
    "tcc.guide.skip.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What if I skip it?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果跳过会怎样？"
          }
        }
      }
    },
    "tcc.guide.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To accurately clean leftover caches in private folders such as Mail / Safari / Calendar, GSY Clean Mac needs Full Disk Access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了准确清理 Mail / Safari / 日历等隐私目录的残留缓存，GSY 清理管家需要「完全磁盘访问」权限。"
          }
        }
      }
    },
    "tcc.guide.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Full Disk Access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予完全磁盘访问"
          }
        }
      }
    },
    "tcc.guide.why.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS protects user files with TCC. Full Disk Access lets the app inspect caches and developer leftovers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 通过 TCC 保护用户文件，「完全磁盘访问」用于检查缓存和开发者残留。"
          }
        }
      }
    },
    "tcc.guide.why.title": {
      "extractionState": "manual",
      "localizations": {
