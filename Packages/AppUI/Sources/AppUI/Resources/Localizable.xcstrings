    "settings.storage.alert.vacuum.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs VACUUM on SQLite. This only compacts space and never deletes any business data. The size may grow again after the next scan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对 SQLite 执行 VACUUM，仅紧凑空间不删除任何业务数据。下次扫描后体积可能再次回升。"
          }
        }
      }
    },
    "settings.storage.alert.clear_all.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear scan results"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空扫描结果"
          }
        }
      }
    },
    "settings.storage.alert.clear_all.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Truncates the scan_session / scan_result tables and then runs VACUUM. All historical scan records will be unrecoverable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空 scan_session / scan_result 全表后再 VACUUM。所有历史扫描记录将不可恢复。"
          }
        }
      }
    },
    "settings.storage.alert.delete_files.title": {
      "extractionState": "manual",
      "localizations": {
