          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 %@ 排序（再次点击切换升降序）"
          }
        }
      }
    },
    "settings.scan.show_hidden.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show hidden files / folders"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示隐藏文件 / 文件夹"
          }
        }
      }
    },
    "settings.scan.show_hidden.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ON by default: includes dot-prefixed directories such as .cursor / .npm / .cache so totals match Finder/du. When off, only visible files are scanned and totals will be noticeably smaller than Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 ON：扫描会包含 .cursor / .npm / .cache 等以 . 开头的目录，体积才能与 Finder/du 对齐。关掉后只看可见文件，结果会显著小于 Finder。"
          }
        }
      }
    },
    "settings.scan.section.behavior": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan behavior"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描行为"
          }
        }
      }
    },
    "settings.scan.size_mode.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Byte accounting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字节口径"
          }
        }
      }
    },
    "settings.scan.size_mode.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "logical (default): matches System Settings / Finder / Get Info; APFS clones / hardlinks are not deduplicated and every file counts its full size.\\nphysical: matches du / df; counts actual disk blocks, so sparse / hardlinked files are smaller and reflect what you would actually reclaim.\\nA rescan is required after switching for totals to recompute under the new mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "logical（默认）：与系统设置 / Finder / 「显示简介」完全一致；APFS clone / hardlink 不去重，每个文件按完整 size 算。\\nphysical：与 du / df 一致；按实际占用磁盘 block 算，sparse / hardlink 文件更小，反映「删了真能释放多少」。\\n切换后需要重新扫描才能让总数按新口径累计。"
          }
        }
      }
    },
    "settings.scan.section.size_mode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size accounting mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体积统计口径"
          }
        }
      }
    },
    "settings.scan.hud.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan HUD"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描悬浮窗（HUD）"
          }
        }
      }
    },
    "settings.scan.hud.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ON by default. While scanning, a capsule under the notch shows reclaimable / free / progress bar / ETA. Toggle anytime with ⌘⇧H or the toolbar button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 ON。扫描时在屏幕顶部刘海下方居中显示一个胶囊：可清理 / 可用 / 比例条 / 预计剩余时间。可随时通过 ⌘⇧H 或工具栏按钮切换。"
          }
        }
      }
    },
    "settings.scan.hud_persistent.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persistent HUD widget mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HUD 常驻挂件模式"
          }
        }
      }
    },
    "settings.scan.hud_persistent.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the HUD stays visible even when not scanning, acting as a desktop / top widget. The idle state shows disk usage and a one-click scan button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后即使未在扫描，HUD 也持续显示，作为桌面 / 顶部小挂件。闲置态显示磁盘已用比例 + 一键开始扫描。"
          }
        }
      }
    },
    "settings.scan.hud_placement.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HUD placement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HUD 位置"
          }
        }
      }
    },
    "settings.scan.hud_placement.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top center (under the notch) = floating level, always above every app window. The three desktop options sit above desktop icons but below app windows, mimicking a desktop widget without stealing focus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶部居中（刘海下方）= floating 级，永远在所有 App 窗口之上；桌面三档 = 桌面图标之上、App 窗口之下，模拟桌面小控件，不抢前台焦点。"
          }
        }
      }
    },
    "settings.scan.tray.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu bar tray icon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏托盘图标"
          }
        }
      }
    },
    "settings.scan.tray.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ON by default. Shows an icon in the right side of the menu bar; click to open the main window, start the recommended scan, or toggle the HUD. The icon is removed immediately when turned off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 ON。在系统菜单栏右侧显示一个图标，点击可快速打开主窗口、开始推荐扫描、显示/隐藏悬浮窗。关掉后图标立即移除。"
          }
        }
      }
    },
    "settings.scan.hide_dock.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide from Dock when main window is closed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭主窗口后从 Dock 隐藏"
          }
        }
      }
    },
    "settings.scan.hide_dock.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OFF by default. When on, closing the main window hides the app into the menu bar tray (Dock icon and main menu disappear together). Click \"Open Main Window\" in the tray to bring it back. The tray icon must remain enabled, otherwise the app has no entry point after closing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 OFF。开启后，关掉主窗口 = App 隐入菜单栏托盘（Dock 图标 + 顶部主菜单一起消失）；点托盘 \"打开主窗口\" 即可拉回。需要保留菜单栏托盘开启，否则 App 关窗后将完全没有入口。"
          }
        }
      }
    },
