    "category.xcode.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DerivedData contains Xcode build caches such as CompilationCache.noindex and ModuleCache.noindex. Xcode or SwiftBuild may recreate them after cleanup, and sparse files can make the displayed logical size differ from the space actually freed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DerivedData 包含 CompilationCache.noindex、ModuleCache.noindex 等 Xcode 构建缓存。清理后 Xcode 或 SwiftBuild 可能重新创建它们；稀疏文件还会让显示的逻辑大小和实际释放空间不完全一致。"
          }
        }
      }
    },
