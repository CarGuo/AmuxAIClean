    "ai.unconfigured.alert.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ask AI” needs API Base URL / Model / API Key configured in Settings first. Tap “Open Settings” to jump to the AI settings pane."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「问 AI」需要先在设置中填好 API Base URL / Model / API Key。点「前往设置」可立即打开 AI 设置面板。"
          }
        }
      }
    },
    "ai.unconfigured.alert.open_settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往设置"
          }
        }
      }
    },
    "ai.unconfigured.alert.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Not Configured"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
