    "trash.err.partial_note %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (already moved %lld items to Trash, recoverable in “Recently Deleted”)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（已成功放入废纸篓 %lld 项，可在「最近删除」恢复）"
          }
        }
      }
    },
    "trash.err.recycle_failed %lld %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "recycle-failed: %1$lld items could not be moved to Trash%2$@%3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "recycle-failed：%1$lld 项无法移到废纸篓%2$@%3$@"
          }
        }
      }
    },
    "trash.err.recycle_budget_expired %lld %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The overall wait budget was reached. %1$lld later items were not submitted; %2$lld were confirmed moved to Trash and %3$lld failed." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已达到本次操作的整体等待预算。后续 %1$lld 项未提交；已确认 %2$lld 项移到废纸篓，%3$lld 项失败。" } }
      }
    },
    "trash.err.recycle_pending %lld %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The final result is not yet confirmed for %1$lld items handed to macOS; %2$lld later items were not submitted. %3$lld items were confirmed moved to Trash. Do not retry the pending items immediately; rescan to confirm their status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已交给 macOS 的 %1$lld 项最终结果尚未确认；后续 %2$lld 项未提交。已确认 %3$lld 项移到废纸篓。请勿立即重试待确认项，重新扫描后再确认状态。"
          }
        }
      }
    },
    "trash.err.recycle_submission_unknown %lld %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The system recycle API did not return for %1$lld items, so acceptance is unknown; %2$lld later items were not submitted. %3$lld items were confirmed moved to Trash. Do not retry the unknown items; rescan later." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "%1$lld 项的系统废纸篓 API 未返回，是否接受未知；后续 %2$lld 项未提交。已确认 %3$lld 项移到废纸篓。请勿重试未知项，稍后重新扫描。" } }
      }
    },
    "trash.err.safety_blocked_only %lld %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "safety-blocked: %1$lld paths blocked by safety policy; first reason=%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "safety-blocked：%1$lld 路径被安全策略拦截；首条原因=%2$@"
          }
        }
      }
    },
