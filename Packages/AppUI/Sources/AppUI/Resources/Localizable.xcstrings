    "op.result.hint.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These paths are protected by built-in safety rules to prevent destroying the system or other apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些路径被内置安全规则保护，避免误删系统或其他应用。"
          }
        }
      }
    },
    "op.result.hint.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These paths could not be moved to Trash. Common causes: the file is in use by another process (e.g. running emulator), permissions issue, or special attributes (xattr / read-only). Try quitting the related app and retry, or delete the path manually in Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些路径无法移到废纸篓。常见原因：文件被其他进程占用（如运行中的模拟器）、权限问题、或特殊属性（xattr / 只读）。可以先退出相关应用再重试，或者在「访达」里手动删除。"
          }
        }
      }
    },
    "op.result.hint.not_submitted": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The operation reached its overall wait budget, so these later items were not handed to macOS. They remain unchanged and may be reviewed and submitted again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "本次操作已达到整体等待预算，因此这些后续项目未交给 macOS。它们保持不变，可重新审阅后再次提交。" } }
      }
    },
    "op.result.hint.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of this request was handed to macOS, but its final result is not yet confirmed. Do not submit the pending items again now. Rescan later to confirm what changed; later items listed below were deliberately not submitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分请求已交给 macOS，但最终结果尚未确认。请勿立即重复提交待确认项；稍后重新扫描以确认实际变化。下列后续项已主动停止提交。"
          }
        }
      }
    },
    "op.result.hint.submission_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The system recycle API did not return before the wait budget ended, so macOS acceptance is unknown. Do not retry these items. Rescan later to reconcile their actual state." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "系统废纸篓 API 在等待预算内没有返回，因此无法确认 macOS 是否已接受请求。请勿重试这些项目，稍后重新扫描以对账实际状态。" } }
      }
    },
    "op.result.hint.running_skipped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You chose to leave these items untouched because their related apps are running. They remain selected so you can retry after quitting those apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择了不处理这些运行中应用的相关项目。它们会保持选中，退出相关应用后可再次尝试。"
          }
        }
      }
    },
    "op.result.more %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "…and %lld more"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "…另有 %lld 项"
          }
        }
      }
    },
    "op.result.reason.access_denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No permission to delete (grant Full Disk Access in System Settings)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有删除权限（请在系统设置中授予完全磁盘访问）"
          }
        }
      }
    },
    "op.result.reason.batch_atomic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The batch contains a protected path, so no item was changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一批次包含受保护路径，因此本项也未执行任何更改"
          }
        }
      }
    },
    "op.result.reason.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked by built-in safety rule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命中内置安全规则"
          }
        }
      }
    },
    "op.result.reason.trash_pending_operation": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A previous Trash request for this exact item is still pending. Nothing was submitted again; rescan later to reconcile it." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这个项目之前的废纸篓请求仍待确认。本次没有重复提交，请稍后重新扫描对账。" } }
      }
    },
    "op.result.reason.trash_pending_identity_changed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The path now refers to a different filesystem item. The old authorization was rejected; rescan and review the new item." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "该路径现在指向不同的文件系统项目，旧授权已被拒绝；请重新扫描并审阅新项目。" } }
      }
    },
    "op.result.reason.trash_pending_target_missing": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The original item is no longer at this path. Nothing was submitted; rescan to refresh the result." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "原项目已不在该路径，本次没有提交；请重新扫描刷新结果。" } }
      }
    },
    "op.result.reason.trash_pending_ledger_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The app could not safely verify the pending-operation ledger, so no Trash request was submitted." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "应用无法安全核验待确认操作记录，因此没有提交废纸篓请求。" } }
      }
    },
    "op.result.reason.trash_pending_fresh_review_required": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "An earlier unresolved Trash request no longer matches this path. Nothing was submitted; run a fresh scan and explicitly review the current item before trying again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "之前未决的废纸篓请求已不再匹配当前路径。本次没有提交；请完成一次全新扫描并明确审阅当前项目后再试。" } }
      }
    },
    "op.result.reason.trash_submission_queue_expired": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The submission queue did not obtain the system-call claim before the wait budget ended. Nothing was submitted; review and try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "提交队列在等待预算结束前未取得系统调用资格，本次没有提交；请重新审阅后再试。" } }
      }
    },
    "op.result.reason.target_evidence_missing": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The scan did not provide target-specific evidence, so this item was not changed." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "本轮扫描没有提供该目标的精确证据，因此未执行更改" } }
      }
    },
    "op.result.reason.target_identity_changed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The target changed after confirmation. Review it and try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "确认后目标已发生变化，请重新检查后再试" } }
      }
    },
    "op.result.reason.target_move_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The target cannot currently be moved from its parent directory. No files were changed." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前无法从父目录移动该目标，未更改任何文件" } }
      }
    },
    "op.result.reason.target_immutable": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The target or its parent is marked immutable and cannot be moved." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "目标或其父目录被标记为不可变，无法移动" } }
      }
