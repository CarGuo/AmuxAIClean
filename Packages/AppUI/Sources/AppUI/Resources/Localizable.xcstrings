    "settings.storage.section.log.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolls daily and keeps the last 7 days. Debug builds include the debug level by default; release builds only info and above. Attach the log to your bug report when needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按天滚动，保留最近 7 天。Debug 构建默认含 debug 级，Release 构建仅 info 及以上。遇到问题可把日志附给开发者。"
          }
        }
      }
    },
