    "appfootprint.partial.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scan reached its safety budget. The displayed size is a known lower bound, not the app's exact size."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描已达到安全预算。当前显示的是已知占用下界，并非该应用的精确大小。"
          }
        }
      }
    },
