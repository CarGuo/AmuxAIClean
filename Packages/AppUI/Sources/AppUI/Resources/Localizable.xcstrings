    "batch.developer.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer artifacts are mostly caches or generated output. Tools such as Xcode may recreate them after cleanup; sparse cache files can show a large logical size while using much less disk space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发者构建产物大多是缓存或生成物，清理后 Xcode 等工具可能自动重建；部分稀疏缓存文件会显示很大的逻辑大小，但实际占用可能小得多。"
          }
        }
      }
    },
    "batch.developer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Artifacts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发者构建产物"
          }
        }
      }
    },
